{
  "name": "mimobal",
  "version": "0.1.0",
  "description": "MiMo 余额 / Token Plan 桌面悬浮窗 + 托盘仪表盘",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.galaxrin.mimobal",
    "productName": "MiMoBal",
    "executableName": "MiMoBal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "fields.js",
      "data.js",
      "preload.js",
      "float.html",
      "settings.html",
      "icon.png",
      "icon@2x.png",
      "icon-win.png"
    ],
    "win": {
      "icon": "icon.ico",
      "artifactName": "MiMoBal-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MiMoBal",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerLanguages": ["zh_CN"],
      "displayLanguageSelector": false
    }
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  }
}
